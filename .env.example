NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/control_acceso_v2
API_PORT=4000
OPERATING_TIMEZONE=America/Cancun
WEB_ORIGIN=http://localhost:5173
WEB_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=ca_session
USER_SESSION_COOKIE_NAME=ca_user_session
SESSION_SECRET=development-session-secret
TOKEN_SIGNING_SECRET=development-token-signing-secret
RATE_LIMIT_DRIVER=memory
INITIAL_ADMIN_USERNAME=superadmin
INITIAL_ADMIN_PASSWORD=Cambiar123!
STORAGE_DRIVER=local
LOCAL_STORAGE_ROOT=.local-storage

# Optional production signing keys for dynamic QR.
# Leave empty in development to use an ephemeral ES256 key.
QR_SIGNING_PRIVATE_KEY=
QR_SIGNING_PUBLIC_KEY=
QR_SIGNING_ALG=ES256
QR_SIGNING_KID=

PUBLIC_API_BASE_URL=http://localhost:4000
